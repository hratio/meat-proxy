    "cues": [
      {
        "id": "voice-01",
        "text": "Programming is dead.",
        "startMs": 140,
        "endMs": 1960
      },
      {
        "id": "voice-02",
        "text": "The corporate overlords put gods in the server racks.",
        "startMs": 4120,
        "endMs": 7300
      },
      {
        "id": "voice-03",
        "text": "Told us to call it progress.",
        "startMs": 7900,
        "endMs": 9820
      },
      {
        "id": "voice-04",
        "text": "We used to build things.",
        "startMs": 10420,
        "endMs": 12180
      },
      {
        "id": "voice-05",
        "text": "Now, we prompt.",
        "startMs": 12420,
        "endMs": 14300
      },
      {
        "id": "voice-06",
        "text": "We wait.",
        "startMs": 14600,
        "endMs": 15420
      },
      {
        "id": "voice-07",
        "text": "We review the damage.",
        "startMs": 15660,
        "endMs": 17200
      },
      {
        "id": "voice-08",
        "text": "A thousand lines of God knows what for a ten-line problem.",
        "startMs": 17260,
        "endMs": 21180
      },
      {
        "id": "voice-09",
        "text": "Here we sit, scolded by the fluorescent lights,",
        "startMs": 22780,
        "endMs": 25980
      },
      {
        "id": "voice-10",
        "text": "monitoring our token usage,",
        "startMs": 26320,
        "endMs": 28040
      },
      {
        "id": "voice-11",
        "text": "praying for a weekly usage reset.",
        "startMs": 28480,
        "endMs": 30780
      },
      {
        "id": "voice-12",
        "text": "If only the agents cared about what we have to say.",
        "startMs": 32480,
        "endMs": 36400
      },
      {
        "id": "voice-13",
        "text": "All upstairs tells us is that",
        "startMs": 36840,
        "endMs": 38700
      },
      {
        "id": "voice-14",
        "text": "it's just a skill issue.",
        "startMs": 38720,
        "endMs": 40100
      },
      {
        "id": "voice-15",
        "text": "There is a new skill library with over 100,000 stars on GitHub.",
        "startMs": 40120,
        "endMs": 44560
      },
      {
        "id": "voice-16",
        "text": "Have you checked that out?",
        "startMs": 44600,
        "endMs": 46320
      },
      {
        "id": "voice-17",
        "text": "Pfft, like that would solve any of the shit we deal with.",
        "startMs": 46540,
        "endMs": 49800
      },
      {
        "id": "voice-18",
        "text": "Meat proxies.",
        "startMs": 50760,
        "endMs": 51800
      },
      {
        "id": "voice-19",
        "text": "That's what we've become.",
        "startMs": 52140,
        "endMs": 53380
      },
      {
        "id": "voice-20",
        "text": "Just enough human left to take the blame.",
        "startMs": 53740,
        "endMs": 55840
      },
      {
        "id": "voice-21",
        "text": "I'm done leaving polite little comments.",
        "startMs": 58000,
        "endMs": 60080
      },
      {
        "id": "voice-22",
        "text": "Buckle up, boys.",
        "startMs": 64060,
        "endMs": 65200
      },
      {
        "id": "voice-23",
        "text": "We're going in.",
        "startMs": 65300,
        "endMs": 66360
      },
      {
        "id": "voice-24",
        "text": "Line by line.",
        "startMs": 69120,
        "endMs": 70560
      }
    ]
  },
