{
  "name": "meat-proxy",
  "version": "0.1.0",
  "description": "Rip and review. A local-first code review arena.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hratio/meat-proxy.git"
  },
  "bugs": "https://github.com/hratio/meat-proxy/issues",
  "homepage": "https://github.com/hratio/meat-proxy#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "meat-proxy": "bin/meat-proxy.mjs"
  },
  "files": [
    "bin/meat-proxy.mjs",
    "bin/server-ownership.mjs",
    "build",
    "!build/**/*.map",
    "!build/**/*.map.gz",
    "!build/**/*.map.br",
    "config",
    "schemas",
    "skills",
    "docs/attribution.md",
    "docs/licenses",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "MEAT_PROXY_WORKBENCH=1 vite dev --host 127.0.0.1",
    "prebuild": "npm run models:validate",
    "build": "vite build",
    "models:optimize": "node dev/tooling/models/optimize.mjs",
    "models:validate": "node dev/tooling/weapons/validate.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node bin/meat-proxy.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "schema": "svelte-kit sync && node dev/tooling/schema/generate.mjs",
    "armory:prepare": "node dev/tooling/weapons/prepare-thumbnails.mjs",
    "portrait:lut": "node dev/tooling/splash/color-workshop/lut.mjs && npm run render:prepare",
    "render:prepare": "node dev/tooling/render/prepare.mjs",
    "render:bake-textures": "node dev/tooling/render/bake-textures.mjs",
    "prepack": "npm run build",
    "package:verify": "node dev/tooling/release/package.mjs",
    "package:bootstrap": "node dev/tooling/release/bootstrap.mjs",
    "release": "semantic-release",
    "ui:add": "shadcn-svelte add",
    "check:dev": "svelte-kit sync && MEAT_PROXY_WORKBENCH=1 svelte-kit sync && MEAT_PROXY_WORKBENCH=1 svelte-check --tsconfig ./tsconfig.dev.json --config ./svelte.config.js",
    "test": "vitest run",
    "dev:pages": "MEAT_PROXY_PAGES=1 vite dev --host 127.0.0.1",
    "build:pages": "npm run prebuild && MEAT_PROXY_PAGES=1 vite build && node dev/tooling/site/assets.mjs && node dev/tooling/site/notices.mjs",
    "preview:pages": "MEAT_PROXY_PAGES=1 vite preview --host 127.0.0.1",
    "site:fixture": "node dev/tooling/site/fixture.mjs",
    "check:pages": "MEAT_PROXY_PAGES=1 svelte-kit sync && MEAT_PROXY_PAGES=1 svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.48.0",
    "@noble/hashes": "^2.4.0",
    "@pierre/diffs": "^1.4.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@types/culori": "4.0.1",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "bits-ui": "^2.18.0",
    "cn": "^0.4.0",
    "culori": "4.0.2",
    "diff": "^9.0.0",
    "draco3dgltf": "1.5.7",
    "minisearch": "^7.2.0",
    "paneforge": "^1.0.2",
    "playwright": "1.63.0",
    "semantic-release": "25.0.9",
    "shadcn-svelte": "^1.7.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "packageManager": "npm@11.19.0"
}
